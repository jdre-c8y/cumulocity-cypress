exports[`the probe back-end emits a throwaway spec that collects 1`] = `
"// GENERATED by c8y-cygen, probe back-end. THROWAWAY - never committed.
// It collects and asserts nothing. Its only product is the facts document.
describe('Tests for device events [probe]', () => {
  beforeEach(() => {
    cy.login(Cypress.env('username'), Cypress.env('password'));
  });

  it('probe: Verify the event for a device shows respective event details', () => {
    const deviceName = \`e2eDeviceToTestEvents\${Cypress._.now()}\`;

    cy.createDevice({ name: deviceName });
    cy.getDeviceIdByName(deviceName).then((deviceId: any) => {
      cy.request('/event/events', 'POST', { source: { id: deviceId }, type: 'c8y_LocationUpdate', text: 'Location update', c8y_Position: { lat: 52.534925, lng: 17.582658 }, time: dayjs().format('YYYY-MM-DDTHH:mm:ssZ') });
      cy.visitAndWaitUntilPageLoad(\`/apps/devicemanagement/index.html#/device/\${deviceId}/events\`, false);
      cy.c8yCygenCollect({ label: 'events-page', within: 'c8y-device-events' });
      cy.c8yCygenProvisional('open-first-event', {"within":"c8y-device-events","tag":"li","nth":0}).click();
      cy.c8yCygenCollect({ label: 'event-detail', within: 'c8y-event-details' });
    });
  });
});
"
`;

exports[`the spec back-end emits the oracle's shape 1`] = `
"import * as dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';

dayjs.extend(utc);

describe('Tests for device events', { tags: ['@deviceManagementTeam', '@dataAndControlTeam', '@requiresBackend'] }, () => {
  beforeEach(() => {
    cy.login(Cypress.env('username'), Cypress.env('password'));
  });

  it('Verify the event for a device shows respective event details', () => {
    const deviceName = \`e2eDeviceToTestEvents\${Cypress._.now()}\`;

    cy.createDevice({ name: deviceName });
    cy.getDeviceIdByName(deviceName).then((deviceId: any) => {
      cy.request('/event/events', 'POST', { source: { id: deviceId }, type: 'c8y_LocationUpdate', text: 'Location update', c8y_Position: { lat: 52.534925, lng: 17.582658 }, time: dayjs().format('YYYY-MM-DDTHH:mm:ssZ') });
      cy.visitAndWaitUntilPageLoad(\`/apps/devicemanagement/index.html#/device/\${deviceId}/events\`, false);
      cy.get('c8y-tabs-outlet').should('be.visible');
      cy.get('[data-cy="c8y-events-list--timeline-item"]').click();
      cy.get('[data-cy="c8y-event-details--source-wrapper"]').should('contain.text', deviceName);
      cy.get('[data-cy="c8y-event-details--time-wrapper"]')
        .invoke('text')
        .then((text) => {
          expect(dayjs(text).diff(dayjs().utc(), 'minutes')).to.be.within(-3, 3);
        });
      cy.get('[data-cy="c8y-event-details--type-wrapper"]').should('contain.text', 'c8y_LocationUpdate');
      cy.get('[data-cy="c8y-event-details--creation-time-wrapper"]')
        .invoke('text')
        .then((text) => {
          expect(dayjs(text).diff(dayjs().utc(), 'minutes')).to.be.within(-3, 3);
        });
      cy.get('[data-cy="event-details-custom-data-item"]').should('have.length.at.least', 1);
      cy.get('[data-cy="event-details-custom-data"]').should('contain.text', '52.534925');
      cy.get('[data-cy="event-details-custom-data"]').should('contain.text', '17.582658');
    });
  });
});
"
`;
